def big : ℕ := 

def key (bs : List Bool) : ℕ := (List.range 11).foldr (fun i acc => if bs.getD i false then 2 ^ i + acc else acc) 0

def pick (bs : List Bool) : List ℕ × List (Fin 11) := cands.getD (big / 2 ^ (9 * key bs) % 512) ([], [])

def good (bs : List Bool) (p : List ℕ × List (Fin 11)) : Bool :=
  p.1.all (fun a => (List.range 11).all (fun i => !(bs.getD i false) || !(a.testBit i))) &&
  E.all (fun e => bs.getD e.1 false || bs.getD e.2 false || decide (e.1 ∈ p.2) || decide (e.2 ∈ p.2))

def static (p : List ℕ × List (Fin 11)) : Bool :=
  decide (List.Pairwise (fun a b => a &&& b = 0) p.1) && p.1.all (fun a => decide (a ∈ M)) &&
  decide (p.2.toFinset.card ≤ (p.1.map (fun a => (a.bitIndices.length + 1) / 2)).sum)

def full (bs : List Bool) : Bool := good bs (pick bs) && static (pick bs)

theorem all_good_0 : ∀ b3 b4 b5 b6 b7 b8 b9 b10 : Bool,
    full [false, false, false, b3, b4, b5, b6, b7, b8, b9, b10] = true := by decide +kernel

